{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"https://codeberg.org/kytta/renovate-config/raw/branch/main/default.json",
		":maintainLockFilesMonthly",
		":separatePatchReleases",
		":label(dependencies)"
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^Containerfile$/"],
			"matchStrings": [
				"# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+?)\\s"
			]
		}
	],
	"minimumReleaseAge": "3 days",
	"packageRules": [
		{
			"matchManagers": ["github-actions"],
			"groupName": "GitHub Actions"
		},
		{
			"extends": ["monorepo:astro"],
			"groupName": "Astro dependencies"
		},
		{
			"extends": ["packages:eslint"],
			"groupName": "ESLint and plugins"
		},
		{
			"extends": ["packages:stylelint"],
			"groupName": "Stylelint and plugins"
		}
	],
	"postUpdateOptions": ["pnpmDedupe"]
}
